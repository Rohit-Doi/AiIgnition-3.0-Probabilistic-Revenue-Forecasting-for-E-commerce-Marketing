# LLM keys for the dashboard / API insight layer. run.sh never reads these.
# Any one provider is enough. Providers are tried in the order: Groq, Gemini, OpenAI.
GROQ_API_KEY=your_groq_key_here
# Optional second key, used when the first is rejected or rate limited
# GROQ_API_KEY_FALLBACK=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional: force a specific model instead of the first one the key can use
# LLM_MODEL=openai/gpt-oss-120b
# Optional: write insights with rules only (no network calls)
# AIGNITION_DISABLE_LLM=1
